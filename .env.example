# Copy to .env (git-ignored) and fill in. Upload requires login; if OIDC_ISSUER is unset,
# the server still runs and uploads return 503.
ADDR=:8080
ASSETS_DIR=./assets
TEMPLATES_DIR=./templates
MAX_UPLOAD_MB=50

# OpenID Connect (Authorization Code + PKCE)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
# At least 32 random bytes, e.g. `openssl rand -hex 32`. Required when OIDC_ISSUER is set.
SESSION_SECRET=
# Set to false only for plain-http localhost development.
COOKIE_SECURE=false
